# configs/cartographer/g1_2d.rviz
# 作用：人工核查 SLAM 是否稳定（子图 / 轨迹 / 当前帧 / TF / 激光）。
# 说明：本机 rviz2 属于 Unitree rootless Lyrical 安装，RoboStack Jazzy 侧未安装 rviz2，
#       因此**本文件未在本实验中实测运行**（README 的"已知限制"中标注 NOT_MEASURED）。
Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Submap
      Topic: /submap_list
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic: /scan
      Style: Points
      Size (m): 0.02
      Color: 255; 60; 60
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Odometry
      Name: TrackedPose
      Topic: /tracked_pose
      Keep: 200
      Shape: Axes
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Topic: /trajectory_node_list
      Color: 30; 200; 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 40
      Target Frame: map
